# Yahoo Mail MCP Server Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# =============================================================================
# REQUIRED: Yahoo Mail Credentials
# =============================================================================

# Your Yahoo Mail email address
YAHOO_EMAIL=your.email@yahoo.com

# Yahoo Mail app-specific password (16 characters)
# Generate at: https://login.yahoo.com/account/security/app-passwords
# Instructions:
#   1. Go to https://login.yahoo.com/account/security
#   2. Click "Generate app password" or "Manage app passwords"
#   3. Select "Other App" and enter "MCP Server"
#   4. Copy the generated 16-character password
YAHOO_APP_PASSWORD=your16charpassword

# =============================================================================
# TRANSPORT MODE (for local development)
# =============================================================================

# Choose transport mode:
#   - stdio: For local desktop use with Claude Desktop
#   - sse: For HTTP/SSE mode (required for Render.com deployment)
TRANSPORT_MODE=stdio

# Port for SSE mode (only used when TRANSPORT_MODE=sse)
PORT=3000

# =============================================================================
# OPTIONAL: OAuth2 Credentials
# =============================================================================

# If you want to use OAuth2 instead of app passwords (advanced)
# YAHOO_CLIENT_ID=your_client_id
# YAHOO_CLIENT_SECRET=your_client_secret

# =============================================================================
# SECURITY (REQUIRED for production!)
# =============================================================================

# OAuth 2.0 Client Credentials - REQUIRED whenever TRANSPORT_MODE=sse.
# The server exits at startup if these are missing, rather than running
# unauthenticated: without them, anyone who finds the URL can read and delete
# your mail. Local stdio mode does not use them.
# Generate strong random credentials:
#   Client ID: openssl rand -hex 16
#   Client Secret: openssl rand -hex 32
# Configure these in Claude Desktop > Settings > Connectors > Advanced Settings
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here

# Optional: extra Host header values accepted on /mcp/* endpoints.
# Comma-separated. Rejecting unknown Host values blocks DNS rebinding, where a
# malicious page points its own hostname at this server to bypass the browser's
# same-origin policy. Defaults to RENDER_EXTERNAL_HOSTNAME when deployed on
# Render, or localhost:PORT / 127.0.0.1:PORT locally.
# MCP_ALLOWED_HOSTS=mail.example.com,mail.example.com:443

# Optional: extra browser origins allowed to call this server cross-origin.
# Comma-separated. https://claude.ai and https://claude.com are always allowed.
# Only add an entry if you have a browser-based client that needs it.
# MCP_ALLOWED_ORIGINS=http://localhost:6274

# =============================================================================
# PRODUCTION SETTINGS (for Render.com)
# =============================================================================

# When deploying to Render.com, set these in the Render Dashboard:
#   - YAHOO_EMAIL
#   - YAHOO_APP_PASSWORD
#   - TRANSPORT_MODE=sse
#   - OAUTH_CLIENT_ID (generate with: openssl rand -hex 16)
#   - OAUTH_CLIENT_SECRET (generate with: openssl rand -hex 32)
#   - PORT (automatically set by Render)
#   - NODE_ENV=production (automatically set)
# Optional: the public URL clients should use for OAuth discovery.
# Without it the server derives the URL from the request's Host header, which the
# caller controls -- a forged Host would yield a discovery document pointing at
# someone else's authorization and token endpoints. Defaults to
# RENDER_EXTERNAL_HOSTNAME when deployed on Render.
# PUBLIC_URL=https://your-service.onrender.com
